# Server
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB
MONGODB_URI=mongodb://localhost:27017/recall

# Vector search backend: "local" (brute-force cosine similarity, no setup
# required) or "atlas" (requires a MongoDB Atlas cluster with a Vector
# Search index named `vector_index` on notechunks.embedding).
VECTOR_BACKEND=local

# Voyage AI (embeddings) — https://www.voyageai.com/
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# Anthropic (generation) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
